<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>BackoffBus.InMemory</AssemblyName>
    <RootNamespace>BackoffBus</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>In-memory queue provider for BackoffBus.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>integration-events;event-bus;backoff;in-memory</PackageTags>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BackoffBus\BackoffBus.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\BackoffBus\README.md"
          Pack="true"
          PackagePath="\" />
  </ItemGroup>

</Project>
