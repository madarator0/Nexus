<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>BackoffBus.RabbitMQ</AssemblyName>
    <RootNamespace>BackoffBus.RabbitMQ</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>RabbitMQ queue provider for BackoffBus.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>integration-events;event-bus;backoff;rabbitmq</PackageTags>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RabbitMQ.Client" Version="7.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BackoffBus\BackoffBus.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\BackoffBus\README.md"
          Pack="true"
          PackagePath="\" />
  </ItemGroup>

</Project>
